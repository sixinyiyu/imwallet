{
  "name": "imwallet",
  "version": "1.2.17",
  "private": true,
  "description": "多链去中心化钱包 - 私有链钱包应用",
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "local": "pwsh -File scripts/local.ps1 start",
    "local:server": "pwsh -File scripts/local.ps1 server",
    "local:mobile": "pwsh -File scripts/local.ps1 mobile",
    "local:stop": "pwsh -File scripts/local.ps1 stop",
    "local:status": "pwsh -File scripts/local.ps1 status",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:server": "cargo build --release --workspace",
    "test:server": "cargo test --workspace",
    "lint:server": "cargo fmt -- --check && cargo clippy -- -D warnings",
    "check:server": "cargo check --workspace",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "trigger": "node scripts/trigger-pipeline.js",
    "trigger:android": "node scripts/trigger-pipeline.js android",
    "trigger:android-eas": "node scripts/trigger-pipeline.js android-eas",
    "trigger:ios": "node scripts/trigger-pipeline.js ios",
    "trigger:ios-store": "node scripts/trigger-pipeline.js ios-store",
    "trigger:server": "node scripts/trigger-pipeline.js server",
    "trigger:server-docker": "node scripts/trigger-pipeline.js server-docker",
    "trigger:server-ci": "node scripts/trigger-pipeline.js server-ci"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}